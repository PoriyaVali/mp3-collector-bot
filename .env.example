# --- Required -------------------------------------------------------------
# From https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# From @BotFather
BOT_TOKEN=
# Numeric Telegram id(s) of the admin(s), comma separated (ask @userinfobot)
ADMIN_IDS=

# --- Direct download links ------------------------------------------------
# Host port the download server is published on
WEB_PORT=8080
# Address users open; use your domain if you have one (https via a reverse proxy)
BASE_URL=http://YOUR_SERVER_IP:8080

# --- Defaults (can be changed later from the bot's settings) ---------------
# MP3s per ZIP
BATCH_SIZE=30
# Days a download link stays valid (0 = forever; the ZIP is deleted from the server after that)
LINK_EXPIRE_DAYS=7
# Send a partial ZIP after this many hours without a new song (0 = never, only /flush)
AUTO_FLUSH_HOURS=12
# 1 = anyone may add channels, 0 = admins only
ALLOW_USERS=1

# --- Advanced ---------------------------------------------------------------
# A ZIP never grows past this (Telegram's upload limit is 2000 MB)
MAX_ZIP_MB=1900
# Minutes between checks of every channel for new posts
SCAN_INTERVAL_MIN=5
# Parallel downloads
DOWNLOAD_WORKERS=2
# 1 = keep the MP3 files after zipping them
KEEP_MP3=0
# Only if Telegram is blocked where the server is: socks5://user:pass@host:port
TG_PROXY=
# Optional: phone number for `mp3bot login` (asked interactively if empty)
PHONE=
